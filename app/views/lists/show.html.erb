<h2><%= @list.name %></h2>

<%= link_to 'Add bookmark', new_list_bookmark_path(@list), class: 'btn btn-primary' %>
<%= link_to 'Back to the lists', lists_path, class: 'btn btn-secondary' %>

<h3>Bookmarks:</h3>
<ul>
  <% @list.bookmarks.each do |bookmark| %>
    <li>

      Movie: <%= bookmark.movie.title %> -
      Rating: <%= bookmark.movie.rating %> -
      Description: <%= bookmark.movie.overview %> -
      Comment: <%= bookmark.comment %>

      <%= link_to 'Delete', bookmark_path(bookmark), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger btn-sm' %>

    </li>
  <% end %>
</ul>
