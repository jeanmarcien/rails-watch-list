<div class="container py-5">
  <h2 class="text-center mb-4">
    <%= @list.name %> (<%= @list.bookmarks.count %> movie<%= @list.bookmarks.count > 1 ? "s" : "" %>)
  </h2>

  <div class="mb-4 d-flex justify-content-between">
    <div>
      <%= link_to 'Add Bookmark', new_list_bookmark_path(@list), class: 'btn btn-primary btn-lg' %>
    </div>
    <div>
      <%= link_to 'Back to Lists', root_path, class: 'btn btn-secondary btn-lg' %>
    </div>
  </div>

  <h3>Bookmarks:</h3>
  <ul class="list-group mb-4">
    <% @list.bookmarks.each do |bookmark| %>
      <li class="list-group-item d-flex align-items-center">
        <div class="me-3">
          <%= image_tag bookmark.movie.poster_url, class: 'img-thumbnail', alt: "#{bookmark.movie.title} poster", style: 'width: 100px; height: auto;' %>
        </div>
        <div class="flex-grow-1">
          <strong>Movie:</strong> <%= bookmark.movie.title %> <br>
          <strong>Rating:</strong> <%= bookmark.movie.rating %> <i class="fa-solid fa-star" style="color: #FFD43B;"></i><br>
          <strong>Description:</strong> <%= bookmark.movie.overview %> <br>
          <strong>Comment:</strong> <%= bookmark.comment %> <br>

          <%= link_to 'Delete', bookmark_path(bookmark), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: 'btn btn-danger btn-sm mt-2' %>
        </div>
      </li>
    <% end %>
  </ul>

  <% if @list.bookmarks.empty? %>
    <div class="alert alert-warning" role="alert">
      No bookmarks available. Add some bookmarks to your list!
    </div>
  <% end %>
</div>
