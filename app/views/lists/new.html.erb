<div class="container-fluid d-flex align-items-center justify-content-center vh-100">
  <div class="card shadow-sm border-0" style="border-radius: 10px; width: 100%; max-width: 500px;">
    <div class="card-body">
      <h1 class="text-center mb-4">Create a New List</h1>

      <%= simple_form_for @list, html: { class: 'form-horizontal' } do |f| %>
        <div class="form-group">
          <%= f.input :name, collection: [
                "Comedy",
                "Drama",
                "Horror",
                "Superhero",
                "Romance",
                "Documentary",
              ],
            as: :select,
            input_html: { class: 'form-control' },
            label_html: { class: 'col-form-label' },
            label: 'Select Genre' %>
        </div>

        <div class="form-group d-flex justify-content-between">
          <div>
            <%= link_to 'Cancel', root_path, class: 'btn btn-secondary btn-lg' %>
          </div>
          <div>
            <%= f.button :submit, "Create List", class: 'btn btn-primary btn-lg' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
