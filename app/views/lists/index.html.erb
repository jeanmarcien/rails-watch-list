<div class="bg-light py-3 mb-4 shadow-sm">
  <div class="container d-flex justify-content-between align-items-center">
    <h1 class="mb-0" style="font-size: 1.75rem; color: #333;">Movie Lists</h1>
    <%= link_to 'Create a new list', new_list_path, class: 'btn btn-success btn-lg' %>
  </div>
</div>

<div class="container py-5" >
  <div class="row">
    <% @lists.each do |list| %>
      <div class="col-md-4 col-sm-6 mb-4">
        <div class="card h-100 shadow-sm border-0" style="border-radius: 10px;">
          <%= cl_image_tag(list.image_url, class: 'card-img-top', alt: list.name, style: 'border-top-left-radius: 10px; border-top-right-radius: 10px;') %>
          <div class="card-body d-flex flex-column">
            <h5 class="card-title text-primary"><%= list.name %></h5>
            <p class="card-text text-muted"><%= list.description %></p>
            <%= link_to 'View List', list_path(list), class: 'btn btn-outline-primary mt-auto' %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
