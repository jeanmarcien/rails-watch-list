<div class="banner" style="background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url(<%= image_path('movie_banner.png') %>);">
</div>

<div class="container py-5">
  <h1 class="text-center mb-4">Movie Lists</h1>

  <ul class="list-group mb-4">
    <% @lists.each do |list| %>
      <li class="list-group-item list-item">
        <%= link_to list.name, list_path(list), class: 'text-decoration-none' %>
      </li>
    <% end %>
  </ul>

  <div class="text-center">
    <%= link_to 'Create a new list', new_list_path, class: 'btn btn-primary btn-lg' %>
  </div>
</div>
