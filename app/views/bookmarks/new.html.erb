<div class="container py-5">
  <h3 class="mb-4">Add a movie to <%= @list.name %> list</h3>

  <div class="card shadow-sm p-4 mb-4">
    <%= simple_form_for [@list, @bookmark], html: { class: 'form' } do |f| %>
      <div class="form-group mb-3">
        <%= f.association :movie, prompt: "Select a movie", input_html: { class: 'form-control', data: { controller: "tom-select" } } %>
      </div>

      <div class="form-group mb-3">
        <%= f.input :comment, placeholder: "Comment...", input_html: { class: 'form-control' } %>
      </div>

      <div class="d-flex justify-content-between">
        <%= link_to 'Cancel', lists_path, class: 'btn btn-secondary' %>
        <%= f.submit "Add Movie", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
