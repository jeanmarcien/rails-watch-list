<div class="bg-light py-3 mb-4 shadow-sm">
  <div class="container d-flex justify-content-center align-items-center">
    <h2 class="text-center">
      <h3 class="m-4">Add a movie to <%= @list.name %> list</h3>
    </h2>
  </div>
</div>

<div class="container py-5">

  <div class="card shadow-sm p-4 mb-4">
    <%= simple_form_for [@list, @bookmark], html: { class: 'form' } do |f| %>
      <div class="form-group mb-3">
        <%= f.association :movie, prompt: "Select a movie", input_html: { class: 'form-control', data: { controller: "tom-select" } } %>
      </div>

      <div class="form-group mb-3">
        <%= f.input :comment, placeholder: "Comment...", input_html: { class: 'form-control' } %>
      </div>

      <div class="d-flex justify-content-between">
        <%= link_to 'Cancel', list_path(@list), class: 'btn btn-secondary' %>
        <%= f.submit "Add Movie", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
